# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./config/firebase-service-account.json

# Google AI Studio / Gemini
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# SOF.IA System Configuration
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
API_HOST=localhost

# System Behavior
ENABLE_CASCADES=true
ENABLE_MISSIONS=true
ENABLE_KARMA_SYSTEM=true
MAX_MISSION_DEPTH=5

# Firebase Functions
FUNCTIONS_REGION=us-central1
FUNCTIONS_RUNTIME=nodejs18

# Development
DEBUG=sofIA:*